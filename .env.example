# --- Database ---
# PostgreSQL (production): postgresql+psycopg2://user:password@host:5432/neon_ai
# SQLite (local fallback, no server needed)
DATABASE_URL=sqlite:///./neon_ai.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI (Gemini) ---
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL=gemini-3.5-flash

# --- RAG ---
# Embedding model name from HuggingFace (all-MiniLM-L6-v2 is small and fast)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ChromaDB persistent storage directory
CHROMA_DIR=./chroma_data

# --- Frontend (dev proxy) ---
VITE_API_URL=/api
